---
import { pad2, profile, yearOf } from '../data/profile';

const roles = profile.experience;
const since = Math.min(...roles.map((r) => yearOf(r.start)));
---

<section id="experience" class="container experience" aria-labelledby="experience-heading">
  <div class="head">
    <h2 id="experience-heading" class="heading">Experience</h2>
    <p class="mono meta">({pad2(roles.length)}) roles · {since} — now</p>
  </div>

  <ol class="roles">
    {roles.map((role, i) => (
      <li>
        <article class="role" aria-labelledby={`role-${i}`}>
          <span class="mono index" aria-hidden="true">{pad2(i + 1)}</span>
          <div class="body">
            <h3 id={`role-${i}`} class="title">
              {role.role} <span class="serif company">at {role.company}</span>
            </h3>
            <p class="summary">{role.summary}</p>
            {role.highlights.length > 0 && (
              <ul class="highlights">
                {role.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
          </div>
          <p class="mono when">
            <span class="dates">{role.start} — {role.end}</span>
            <span>{role.place} · {role.type}</span>
          </p>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience {
    padding-top: var(--section-y);
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .meta {
    color: var(--muted);
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .roles > li {
    border-bottom: 1px solid var(--rule);
  }

  .roles > li:last-child {
    border-bottom-color: var(--ink);
  }

  .role {
    padding: 36px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
  }

  .index {
    flex: 0 0 48px;
    color: var(--accent);
    padding-top: 10px;
  }

  .body {
    flex: 999 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .title {
    font-weight: 700;
    font-size: var(--fs-role);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .company {
    display: inline-block;
    font-size: var(--fs-company);
    letter-spacing: 0;
    margin-left: 8px;
  }

  .summary {
    max-width: 640px;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .highlights {
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px 32px;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .highlights li {
    padding: 10px 0 0 18px;
    border-top: 1px solid var(--rule-light);
  }

  .when {
    flex: 1 1 200px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    color: var(--muted);
    padding-top: 10px;
  }

  .dates {
    color: var(--ink);
  }

  /* Narrow: index and dates share a line above the role. */
  @media (max-width: 640px) {
    .role {
      padding: 28px 0;
      gap: 12px 16px;
    }

    .index {
      flex: 0 0 auto;
      padding-top: 0;
    }

    .when {
      order: 1;
      flex: 1 1 0;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px 16px;
      padding-top: 0;
    }

    .body {
      order: 2;
      flex-basis: 100%;
    }
  }
</style>
