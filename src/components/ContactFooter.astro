---
import { fullName, mailto, profile, socialLinks } from '../data/profile';
---

<footer class="contact">
  <div class="container inner">
    <div class="pitch">
      <p class="mono kicker">Contact</p>
      <h2 class="headline">Let's build<br /><span class="serif">something</span> clean.</h2>
      <a class="email" href={mailto}>
        {profile.email}
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 12L12 4M5 4h7v7"></path>
        </svg>
      </a>
    </div>

    <div class="mono bottom">
      <p>{fullName} · {profile.location}</p>
      <ul>
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} rel="me noopener" target="_blank">
              {link.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))}
        <li><a href="#top">Back to top&nbsp;<span aria-hidden="true">↑</span></a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .contact {
    --focus-ring: var(--on-accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .inner {
    padding-top: var(--section-y);
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 6vw, 72px);
  }

  .pitch {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .headline {
    font-weight: 900;
    font-stretch: 125%;
    font-size: var(--fs-contact);
    letter-spacing: -0.035em;
    line-height: 0.92;
  }

  .email {
    align-self: flex-start;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 28px;
    border-radius: var(--radius-pill);
    background: var(--on-accent);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: clamp(16px, 2vw, 22px);
    overflow-wrap: anywhere;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .email:hover {
    background: var(--ink);
    color: var(--on-accent);
  }

  .email svg {
    flex: none;
  }

  .bottom {
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.45);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
  }

  ul {
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .bottom a {
    color: var(--on-accent);
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    text-underline-offset: 4px;
  }

  .bottom a:hover {
    color: var(--on-accent);
    text-decoration-thickness: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
